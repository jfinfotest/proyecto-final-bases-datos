# App Config
# Entorno de ejecución (development, staging, production)
NODE_ENV=development
# Puerto en el que correrá la aplicación
PORT=3000

# Database
# URL de conexión a la base de datos PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
DATABASE_URL="postgresql://postgres:password@localhost:5432/proyecto_db"

# Authentication
# Clave secreta para firmar tokens JWT (generar con: openssl rand -base64 32)
JWT_SECRET="super_secret_key_change_in_production"
# Tiempo de expiración del token (ej: 1h, 7d)
JWT_EXPIRES_IN="24h"

# API Keys
# Clave de API para servicios externos (ej: Stripe, AWS, SendGrid)
EXTERNAL_SERVICE_API_KEY="your_api_key_here"
# URL base de la API externa
EXTERNAL_SERVICE_URL="https://api.example.com/v1"

# Logging
# Nivel de logs (debug, info, warn, error)
LOG_LEVEL=debug